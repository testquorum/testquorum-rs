{
  "openapi": "3.0.3",
  "info": {
    "title": "TestQuorum API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.194"
  },
  "paths": {
    "/auth/api-keys": {
      "get": {
        "tags": [
          "api-keys"
        ],
        "operationId": "list_api_keys",
        "parameters": [
          {
            "name": "repo_id",
            "in": "query",
            "description": "When set, only return keys owned by this repository",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "API keys belonging to the authenticated account",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApiKeyResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - requires an administrator key"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      },
      "post": {
        "tags": [
          "api-keys"
        ],
        "operationId": "create_api_key",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKeyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "API key created. The `secret` field is shown once and never again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedApiKeyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid scope/owner combination, unknown repo, or display name too long"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - requires an administrator key"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/auth/api-keys/{key_id}": {
      "delete": {
        "tags": [
          "api-keys"
        ],
        "operationId": "delete_api_key",
        "parameters": [
          {
            "name": "key_id",
            "in": "path",
            "description": "The key id returned by create or list",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "API key deleted"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - requires an administrator key, or attempted to delete a UI session key (use POST /auth/logout instead)"
          },
          "404": {
            "description": "API key not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/auth/api-keys/{key_id}/rotate": {
      "post": {
        "tags": [
          "api-keys"
        ],
        "operationId": "rotate_api_key",
        "parameters": [
          {
            "name": "key_id",
            "in": "path",
            "description": "The key id returned by create or list",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RotateApiKeyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Old secret revoked, new secret issued. The `secret` field is shown once and never again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedApiKeyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid expires_in_days"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - requires an administrator key, or the target is a UI session key"
          },
          "404": {
            "description": "API key not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Logged out successfully"
          },
          "401": {
            "description": "Unauthorized - invalid or missing Bearer token"
          },
          "403": {
            "description": "Forbidden - persistent API keys cannot log out; revoke them via DELETE /auth/api-keys/{key_id}"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/auth/onboarding-seen": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "mark_onboarding_seen",
        "responses": {
          "200": {
            "description": "Onboarding marked as seen"
          },
          "401": {
            "description": "Unauthorized - invalid or missing Bearer token"
          },
          "403": {
            "description": "Forbidden - requires an administrator key"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "session_info",
        "responses": {
          "200": {
            "description": "Session information retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing Bearer token"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/billing": {
      "get": {
        "tags": [
          "billing"
        ],
        "operationId": "list_billing",
        "responses": {
          "200": {
            "description": "Repositories with subscription status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BillingRepo"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - billing actions require an administrator key"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/billing/cancel": {
      "post": {
        "tags": [
          "billing"
        ],
        "operationId": "cancel_subscription",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Subscription marked for cancellation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - not the owner, or billing actions require an administrator key"
          },
          "404": {
            "description": "Repository or subscription not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/billing/checkout": {
      "post": {
        "tags": [
          "billing"
        ],
        "operationId": "start_checkout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Checkout session created or subscription updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - billing actions require an administrator key"
          },
          "409": {
            "description": "Quote expired"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/billing/portal": {
      "post": {
        "tags": [
          "billing"
        ],
        "operationId": "open_portal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PortalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Billing portal session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - billing actions require an administrator key"
          },
          "404": {
            "description": "Repository or subscription not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/github/auth/exchange": {
      "post": {
        "tags": [
          "github"
        ],
        "operationId": "exchange_workflow_auth",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Credential issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - malformed challenge or signature"
          },
          "401": {
            "description": "Verification failed: signature, expired challenge, repo mismatch, or missing app install. Collapsed into one response so callers cannot probe which check failed"
          },
          "403": {
            "description": "GitHub App install lacks actions: read permission - the repo owner must re-authorize the app"
          },
          "409": {
            "description": "Artifact not yet visible via GitHub API - retry after a few seconds"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/github/auth/initiate": {
      "post": {
        "tags": [
          "github"
        ],
        "operationId": "initiate_workflow_auth",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Challenge issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitiateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - malformed repository or public key"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/quote": {
      "get": {
        "tags": [
          "quote"
        ],
        "operationId": "get_quote",
        "responses": {
          "200": {
            "description": "Quote retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            }
          },
          "503": {
            "description": "No valid quote available"
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/repos": {
      "get": {
        "tags": [
          "repos"
        ],
        "operationId": "list_repos",
        "responses": {
          "200": {
            "description": "Repositories listed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RepoResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing Bearer token"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/schedule-call": {
      "post": {
        "tags": [
          "schedule-call"
        ],
        "operationId": "schedule_call",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleCallRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Request submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleCallResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or captcha failed"
          },
          "500": {
            "description": "Internal error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiKeyResponse": {
        "type": "object",
        "required": [
          "key_id",
          "key_prefix",
          "display_name",
          "permission",
          "scope",
          "owner_kind",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "$ref": "#/components/schemas/EpochSecs"
          },
          "display_name": {
            "type": "string"
          },
          "expires_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EpochSecs"
              }
            ],
            "nullable": true
          },
          "key_id": {
            "type": "string",
            "description": "Stable identifier for this key, used in delete and rotate\nrequests."
          },
          "key_prefix": {
            "type": "string",
            "description": "First eight characters of the secret, safe to display."
          },
          "owner_kind": {
            "$ref": "#/components/schemas/PublicKeyOwnerKind"
          },
          "permission": {
            "$ref": "#/components/schemas/PublicKeyPermission"
          },
          "scope": {
            "$ref": "#/components/schemas/PublicKeyScope"
          }
        }
      },
      "BillingRepo": {
        "type": "object",
        "required": [
          "repo_id",
          "full_name"
        ],
        "properties": {
          "full_name": {
            "type": "string"
          },
          "repo_id": {
            "type": "string"
          },
          "subscription": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RepoSubscription"
              }
            ],
            "nullable": true
          }
        }
      },
      "Cadence": {
        "type": "string",
        "enum": [
          "monthly",
          "annual"
        ]
      },
      "CancelRequest": {
        "type": "object",
        "required": [
          "repo_id"
        ],
        "properties": {
          "repo_id": {
            "type": "string"
          }
        }
      },
      "CancelResponse": {
        "type": "object",
        "required": [
          "current_period_end",
          "cancel_at_period_end"
        ],
        "properties": {
          "cancel_at_period_end": {
            "type": "boolean"
          },
          "current_period_end": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "required": [
          "repo_id",
          "tier",
          "cadence",
          "currency",
          "quote_id"
        ],
        "properties": {
          "cadence": {
            "$ref": "#/components/schemas/Cadence"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "quote_id": {
            "type": "string"
          },
          "repo_id": {
            "type": "string"
          },
          "tier": {
            "$ref": "#/components/schemas/Tier"
          }
        }
      },
      "CheckoutResponse": {
        "type": "object",
        "properties": {
          "checkout_url": {
            "type": "string",
            "nullable": true
          },
          "updated": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "required": [
          "display_name",
          "permission",
          "scope",
          "owner_kind"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "description": "Human-readable label shown in the dashboard."
          },
          "expires_in_days": {
            "type": "integer",
            "format": "int64",
            "description": "Number of days until the key expires. Omit for no expiry.\nWhen present, must be in the range 1..=3650.",
            "nullable": true,
            "minimum": 0
          },
          "owner_kind": {
            "$ref": "#/components/schemas/PublicKeyOwnerKind"
          },
          "permission": {
            "$ref": "#/components/schemas/PublicKeyPermission"
          },
          "scope": {
            "$ref": "#/components/schemas/PublicKeyScope"
          }
        }
      },
      "CreatedApiKeyResponse": {
        "type": "object",
        "required": [
          "key_id",
          "key_prefix",
          "display_name",
          "permission",
          "scope",
          "owner_kind",
          "created_at",
          "secret"
        ],
        "properties": {
          "created_at": {
            "$ref": "#/components/schemas/EpochSecs"
          },
          "display_name": {
            "type": "string"
          },
          "expires_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EpochSecs"
              }
            ],
            "nullable": true
          },
          "key_id": {
            "type": "string"
          },
          "key_prefix": {
            "type": "string"
          },
          "owner_kind": {
            "$ref": "#/components/schemas/PublicKeyOwnerKind"
          },
          "permission": {
            "$ref": "#/components/schemas/PublicKeyPermission"
          },
          "scope": {
            "$ref": "#/components/schemas/PublicKeyScope"
          },
          "secret": {
            "type": "string",
            "description": "The full secret. Returned once at creation/rotation only and\nnever recoverable afterwards."
          }
        }
      },
      "Currency": {
        "type": "string",
        "enum": [
          "eur",
          "usd",
          "gbp"
        ]
      },
      "CurrencyPrices": {
        "type": "object",
        "required": [
          "eur",
          "usd",
          "gbp"
        ],
        "properties": {
          "eur": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "gbp": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "usd": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "EpochSecs": {
        "type": "integer",
        "format": "int64",
        "description": "Unix epoch seconds.",
        "minimum": 0
      },
      "ExchangeRequest": {
        "type": "object",
        "required": [
          "challenge",
          "signature"
        ],
        "properties": {
          "challenge": {
            "type": "string",
            "description": "The exact challenge value returned by `/initiate`."
          },
          "signature": {
            "type": "string",
            "description": "Base64url-encoded (no padding) ed25519 signature over\n`b\"testquorum-exchange-v1:\" || challenge_bytes`. Signed with\nthe private key whose public half was sent to `/initiate`."
          }
        }
      },
      "ExchangeResponse": {
        "type": "object",
        "required": [
          "api_key",
          "key_id",
          "expires_at"
        ],
        "properties": {
          "api_key": {
            "type": "string",
            "description": "Bearer token to send as `Authorization: Bearer <api_key>` on\nsubsequent requests. Shown once and never recoverable."
          },
          "expires_at": {
            "$ref": "#/components/schemas/EpochSecs"
          },
          "key_id": {
            "type": "string",
            "description": "Stable identifier for the minted credential (for audit /\nfuture revocation surfaces)."
          }
        }
      },
      "InitiateRequest": {
        "type": "object",
        "required": [
          "repository",
          "workflow_run_id",
          "run_attempt",
          "public_key"
        ],
        "properties": {
          "public_key": {
            "type": "string",
            "description": "Base64url-encoded (no padding) 32-byte ed25519 public key. The\nmatching private key never leaves the workflow runner and is\nused to sign the exchange request."
          },
          "repository": {
            "type": "string",
            "description": "`owner/repo`, exactly as `$GITHUB_REPOSITORY` reports in the\nworkflow."
          },
          "run_attempt": {
            "type": "integer",
            "format": "int32",
            "description": "`$GITHUB_RUN_ATTEMPT` — increments on each manual re-run.",
            "minimum": 0
          },
          "workflow_run_id": {
            "type": "integer",
            "format": "int64",
            "description": "`$GITHUB_RUN_ID` — globally-unique identifier for the workflow\nrun.",
            "minimum": 0
          }
        }
      },
      "InitiateResponse": {
        "type": "object",
        "required": [
          "challenge",
          "artifact_name",
          "artifact_filename",
          "expires_at"
        ],
        "properties": {
          "artifact_filename": {
            "type": "string",
            "description": "The single file the artifact must contain. Its body must equal\nthe challenge value verbatim (no trailing whitespace)."
          },
          "artifact_name": {
            "type": "string",
            "description": "The artifact name the workflow must use when uploading."
          },
          "challenge": {
            "type": "string",
            "description": "Single-use challenge string the workflow must include in its\nuploaded artifact."
          },
          "expires_at": {
            "$ref": "#/components/schemas/EpochSecs"
          }
        }
      },
      "PortalRequest": {
        "type": "object",
        "required": [
          "repo_id"
        ],
        "properties": {
          "repo_id": {
            "type": "string"
          }
        }
      },
      "PortalResponse": {
        "type": "object",
        "required": [
          "portal_url"
        ],
        "properties": {
          "portal_url": {
            "type": "string"
          }
        }
      },
      "PublicKeyOwnerKind": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "account"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "repo_id",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "repo"
                ]
              },
              "repo_id": {
